# PostgreSQL connection string (required)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mahami"

# Web Push (optional — generated automatically and stored in the DB if omitted)
# Generate with: npm run vapid
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Reminder scheduler interval in ms (default 20000). Set to 0 to disable on this instance.
REMINDER_INTERVAL_MS=20000
