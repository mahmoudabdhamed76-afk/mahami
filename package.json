{
  "name": "mahami",
  "version": "1.0.0",
  "private": true,
  "description": "مهامي — Smart Task Manager (Next.js + Prisma + PostgreSQL), Arabic RTL, offline-first with real-time sync",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:dev": "prisma migrate dev",
    "db:local": "node scripts/local-db.mjs",
    "setup": "prisma generate && node scripts/migrate.mjs",
    "start:prod": "node scripts/migrate.mjs && next start",
    "vapid": "node scripts/vapid.mjs",
    "test:api": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@lucasmarkes/hairline": "0.5.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^17.2.0",
    "idb": "8.0.4",
    "lucide-react": "1.61.0",
    "motion": "14.5.0",
    "next": "16.4.2",
    "pg": "^8.16.0",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "web-push": "3.6.7",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/web-push": "^3.6.4",
    "tailwindcss": "4.3.3",
    "typescript": "^5.8.3"
  }
}
